# Доступ к API Бринэкса для получения фотографий товаров.
# Скопируйте в brinex.yml и подставьте свой токен. brinex.yml в git не попадает.
#
# Токен выдаёт менеджер поставщика по заявке с указанием статического IP-адреса.
# Запрос с любого другого адреса получает 403 независимо от того, верен ли токен.
token: "выданный-поставщиком-токен"
base_url: "https://api.brinex.ru/v2"

# Отправлять запросы к API через сервер публикации фотографий из photos.yml:
# токен привязан к его адресу, а не к адресу рабочей машины. Через сервер идёт
# только поиск — короткий JSON; сами изображения качаются напрямую с CDN.
via_photo_server: true
